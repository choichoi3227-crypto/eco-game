---
import Layout from '../layouts/Layout.astro';
import { getDb } from '../db/client';
import { gameResults } from '../db/schema';
import { sql } from 'drizzle-orm';
import StatsChart from '../components/StatsChart';

const db = getDb(Astro.locals.runtime.env);
const totalStats = await db.select({
  correct: sql<number>`SUM(correct)`,
  incorrect: sql<number>`SUM(incorrect)`
}).from(gameResults).get();

const ratio = totalStats?.correct ? ((totalStats.incorrect / (totalStats.correct + totalStats.incorrect)) * 100).toFixed(1) : "0";
---

<Layout title="실시간 통계" description="전국 분리수거 오답률과 정답률을 실시간으로 확인하세요.">
  <div class="max-w-4xl mx-auto">
    <header class="text-center mb-12">
      <h1 class="text-4xl font-black text-slate-900 mb-4">분리수거 실시간 리포트</h1>
      <p class="text-slate-500">전국에서 수집된 데이터를 바탕으로 분석한 분리수거 현황입니다.</p>
    </header>

    <div class="grid md:grid-cols-2 gap-8 mb-12">
      <div class="bg-white p-8 rounded-3xl border border-slate-100 shadow-sm text-center">
        <div class="text-sm font-bold text-red-500 mb-2 uppercase">Incorrect Ratio</div>
        <div class="text-6xl font-black text-slate-900">{ratio}%</div>
        <p class="mt-4 text-slate-400 text-sm">잘못 배출되고 있는 쓰레기의 비율입니다.</p>
      </div>
      
      <StatsChart client:load correct={totalStats?.correct || 0} incorrect={totalStats?.incorrect || 0} />
    </div>
  </div>
</Layout>
